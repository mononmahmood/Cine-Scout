# ── TMDB (required) ─────────────────────────────────────────────────────
# v4 Read Access Token from https://www.themoviedb.org/settings/api
# Set it in Vercel → Project → Settings → Environment Variables, then redeploy.
TMDB_TOKEN=your_tmdb_v4_read_token
# …or a v3 API key instead of the token:
# TMDB_API_KEY=your_tmdb_v3_key

# ── Reddit (optional) ───────────────────────────────────────────────────
# App-only OAuth from https://www.reddit.com/prefs/apps (type: "web app" is
# not needed — script/app-only works). Without these the app automatically
# falls back to the public Arctic Shift archive.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Nothing else is needed. Streaming availability comes from TMDB's
# watch/providers endpoint (JustWatch data) — no JustWatch key is used.
